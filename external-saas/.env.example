# PostgreSQL
DATABASE_URL=postgres://nextdue:nextdue@localhost:55432/nextdue

# Auth.js: generate with `openssl rand -base64 32`
AUTH_SECRET=replace-me
AUTH_TRUST_HOST=true
APP_URL=http://localhost:3000

# Google OAuth (optional in local development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generic OIDC (optional; all three values are required together)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=Company SSO
OIDC_ALLOWED_DOMAIN=

# Development-only login. The application rejects this in production.
DEV_AUTH_BYPASS=true
DEV_AUTH_EMAIL=developer@nextdue.local

# Reminder worker
CRON_SECRET=replace-me
REMINDER_POLL_SECONDS=60

# Future notification and connector providers
EMAIL_FROM=
RESEND_API_KEY=
ENCRYPTION_KEY=
SENTRY_DSN=
